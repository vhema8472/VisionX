# Environment Configuration for Co-Workspace Management System
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Set in hosting environment variables or local .env)
MONGO_URI=mongodb://127.0.0.1:27017/coworkspace_db

# Supabase Managed Services Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Authentication Secrets (Must be set in environment)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Admin Credentials
ADMIN_EMAIL=admin@workhub.com
ADMIN_PIN=your_admin_pin_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
